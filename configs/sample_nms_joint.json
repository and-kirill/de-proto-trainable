{
  "protograph": {
    "init_pcm": "input/init.txt",
    "punctured": 0
  },
  "grid": {
    "llr_max": 20,
    "llr_scale": 80,
    "device": "cpu",
    "dtype": "float64"
  },
  "decoder": {
    "type": "nms",
    "col_scales": "input/scales.txt",
    "train_scales": 1
  },
  "optimization": {
    "snr_db": -1.9,
    "n_iter": 50,
    "snr_step": 0.002,
    "ber_threshold": 1e-10,
    "lr_schedule": {
      "initial_rate": 1e-3,
      "acceleration_factor": 1.1,
      "deceleration_factor": 0.75,
      "acceleration_flip_threshold": 1,
      "deceleration_flip_threshold": 3,
      "rollback_flip_threshold": 6
    },
    "convergence": {
      "max_epochs": 2000,
      "ensemble_size_patience": 20
    }
  },
  "data_dir": "history_nms_joint"
}
